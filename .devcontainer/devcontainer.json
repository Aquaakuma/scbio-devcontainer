{
    "name": "scBio",
    "image": "mcr.microsoft.com/devcontainers/base:resolute",
    "features": {
        "ghcr.io/devcontainers/features/conda:2": {}
    },
    "remoteUser": "vscode",
    "containerEnv": {
        "CONDARC": "${containerWorkspaceFolder}/.devcontainer/.condarc"
    },
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "REditorSupport.r",
                "ms-toolsai.jupyter",
                "ms-toolsai.jupyter-renderers",
                "charliermarsh.ruff",
                "redhat.vscode-yaml",
                "timonwong.shellcheck",
                "EditorConfig.EditorConfig"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/conda/envs/scbio/bin/python",
                "python.terminal.activateEnvironment": true,
                "r.executablePath": "/opt/conda/envs/scbio/bin/R",
                "r.consolePath": "/opt/conda/envs/scbio/bin/R",
                "r.alwaysUseActiveTerminal": false,
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.formatOnSave": true
                },
                "r.consoleArgs": [
                    "--no-save",
                    "--no-restore"
                ],
                "r.sessionWatcher": true,
                "r.lsp.enabled": true,
                "python.analysis.typeCheckingMode": "basic",
                "files.eol": "\n",
                "files.insertFinalNewline": true,
                "files.trimTrailingWhitespace": true,
                "[r]": {
                    "editor.tabSize": 2,
                    "editor.insertSpaces": true
                },
                "[yaml]": {
                    "editor.tabSize": 2,
                    "editor.insertSpaces": true
                },
                "files.watcherExclude": {
                    "**/.git/objects/**": true,
                    "**/.ipynb_checkpoints/**": true,
                    "**/.pixi/**": true,
                    "**/.venv/**": true
                },
                "search.exclude": {
                    "**/.ipynb_checkpoints": true,
                    "**/.pixi": true,
                    "**/.venv": true
                }
            }
        }
    }
}
